                            "position": {
                                "context": "correctAnswer",
                                "char_index": 768
                            }
                        },
                        {
                            "id": "q2_2_eq7",
                            "type": "inline",
                            "latex": "A_n<1",
                            "position": {
                                "context": "correctAnswer",
                                "char_index": 820
                            }
                        },
                        {
                            "id": "q2_2_eq8",
                            "type": "inline",
                            "latex": "80\\left(\\tfrac{1}{2}\\right)^n<1\\iff n>\\log_2(80)",
                            "position": {
                                "context": "correctAnswer",
                                "char_index": 840
                            }
                        },
                        {
                            "id": "q2_2_eq9",
                            "type": "inline",
                            "latex": "n=\\lceil\\log_2(80)\\rceil=7",
                            "position": {
