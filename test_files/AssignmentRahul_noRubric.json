                    "question": "(ii) A drug quantity in the body reduces to half after every 6 hours. Starting from 80 mg, use a while loop to find after how many hours the amount will become less than 1 mg?",
                    "equations": [
                        {
                            "id": "q2_2_eq1",
                            "type": "inline",
                            "latex": "A(t)=A_0\\left(\\tfrac{1}{2}\\right)^{t/6}",
                            "position": {
                                "context": "correctAnswer",
                                "char_index": 229
                            }
                        },
                        {
                            "id": "q2_2_eq2",
                            "type": "inline",
                            "latex": "A(t)<1\\ \\text{mg}",
                            "position": {
                                "context": "correctAnswer",
                                "char_index": 311
                            }
                        },
                        {
                            "id": "q2_2_eq3",
                            "type": "inline",
                            "latex": "80\\left(\\tfrac{1}{2}\\right)^{t/6}<1",
                            "position": {
                                "context": "correctAnswer",
                                "char_index": 357
                            }
                        },
                        {
                            "id": "q2_2_eq4",
                            "type": "inline",
                            "latex": "t>6\\,\\frac{\\ln(80)}{\\ln(2)}",
                            "position": {
                                "context": "correctAnswer",
                                "char_index": 553
                            }
                        },
                        {
                            "id": "q2_2_eq5",
                            "type": "inline",
                            "latex": "t>6\\,\\frac{\\ln(80)}{\\ln(2)}\\approx 37.93\\ \\text{h}",
                            "position": {
